// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
// NOTE: this is the built product / bundle *filename* — Finder shows THIS name for
// the .app (not CFBundleName / CFBundleDisplayName), so it must be the user-facing
// name. Referenced by the Xcode project product ref + RunnerTests TEST_HOST, which
// are kept in sync in project.pbxproj.
PRODUCT_NAME = WorkNexus

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.worknexus.workNexus

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 com.worknexus. All rights reserved.

// Optional per-developer local signing (xem Signing.xcconfig.example).
// Thiếu file cũng không sao — build quay về ad-hoc "-" của project.
#include? "Signing.xcconfig"
