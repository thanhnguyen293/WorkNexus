# WorkNexus — Build-time defines
# Usage: flutter run --dart-define-from-file=.env
#        flutter build windows --dart-define-from-file=.env
#
# Copy to .env.staging / .env.production and fill in overrides.
# This file is committed (no secrets here — app identity only). CI overrides
# GITHUB_OWNER / GITHUB_REPO from the repository it runs in (see build.yml);
# the values below are for local runs.

APP_NAME=WorkNexus
GITHUB_OWNER=thanhnguyen293
GITHUB_REPO=WorkNexus
MAC_BUNDLE_ID=com.worknexus.workNexus
WINDOWS_APP_ID=WorkNexus.WorkNexus.Desktop
WINDOWS_GUID=c14901d9-c46d-4d26-9596-9c14e5a0e0b7
DB_NAME=worknexus
# Release asset names the in-app updater downloads (must match the CI upload).
UPDATE_ASSET_WINDOWS=worknexus-windows.zip
UPDATE_ASSET_MACOS=work_nexus-macos.zip
UPDATE_CHECKSUMS_ASSET=SHA256SUMS.txt
