# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Local agent/tooling config
.claude/
.codex/
.mcp.json
/CLAUDE.md

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
*.freezed.dart
*.g.dart
*.config.dart

# Generated localizations (regenerated from lib/l10n/*.arb by `flutter gen-l10n`).
# The .arb source files stay tracked.
/lib/l10n/app_localizations*.dart

# flutter_gen output (regenerated by build_runner). The assets/ sources stay
# tracked; the type-safe accessors are not committed.
/lib/gen/

# Planning / design notes — kept local, not tracked.
/docs/

# Scratch API-response dumps captured while debugging — kept local.
/products_json.txt
/projects_json.txt
