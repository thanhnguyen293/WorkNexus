# ==============================================================================
# Auto-detect text files and normalize line endings to LF on commit
# ==============================================================================
* text=auto eol=lf

# ==============================================================================
# Source Code & Configs (Strict LF enforcement across macOS & Windows)
# ==============================================================================
*.dart          text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.xml           text eol=lf
*.plist         text eol=lf
*.properties    text eol=lf
*.gradle        text eol=lf
*.xcconfig      text eol=lf
*.storyboard    text eol=lf
*.xib           text eol=lf
*.pbxproj       text eol=lf
*.cpp           text eol=lf
*.h             text eol=lf
*.cc            text eol=lf
*.c             text eol=lf
*.swift         text eol=lf
*.kt            text eol=lf
*.java          text eol=lf

# Batch scripts on Windows MUST preserve CRLF to execute properly
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Shell scripts on macOS/Linux MUST preserve LF
*.sh            text eol=lf

# ==============================================================================
# Binary files (Do not apply line ending conversion)
# ==============================================================================
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.svg           binary
*.pdf           binary
*.ttf           binary
*.otf           binary
*.woff          binary
*.woff2         binary
*.jar           binary
*.zip           binary
*.tar.gz        binary
*.icns          binary
*.ico           binary

# Native desktop binaries & prebuilts
*.dll           binary
*.exe           binary
*.dylib         binary
*.so            binary
*.a             binary
*.framework/**  binary
